# API Base URL (Render backend web service URL in production, localhost in development)
# Production: https://<your-backend>.onrender.com (or https://<your-backend>.onrender.com/api/v1)
# Local: http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase Client Configuration (Browser-safe keys only - NEVER include service-role or AI keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_publishable_key

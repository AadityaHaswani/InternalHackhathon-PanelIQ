# Server Configuration
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-panel-iq-frontend.vercel.app,http://localhost:5173

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=

# AI Configuration (Groq primary + Gemini secondary)
AI_MODE=live
PRIMARY_AI_PROVIDER=groq
SECONDARY_AI_PROVIDER=gemini

# Groq (Primary Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Secondary Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Dedicated confirmed test accounts for manual smoke tests only
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
SUPABASE_TEST_EMAIL_2=
SUPABASE_TEST_PASSWORD_2=